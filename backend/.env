# ================================================================
# 🚀 STAGETRACK - VARIABLES D'ENVIRONNEMENT
# ================================================================

# ================================================================
# 1. SERVEUR
# ================================================================
PORT=5000
NODE_ENV=development

# ================================================================
# 2. BASE DE DONNÉES (MongoDB)
# ================================================================
MONGO_URI=mongodb://127.0.0.1:27017/stage_platform

# ================================================================
# 3. JWT (Authentification)
# ================================================================
JWT_SECRET=VotreSuperSecretTrèsLongEtComplexeIci123!
JWT_EXPIRES_IN=90d

# ================================================================
# 4. URL DU FRONTEND (pour les liens de réinitialisation)
# ================================================================
FRONTEND_URL=http://localhost:3000

# ================================================================
# 5. EMAIL (Nodemailer) - Service SMTP
# ================================================================
# Service utilisé (gmail, outlook, sendgrid, etc.)
EMAIL_SERVICE=gmail

# Adresse email de l'expéditeur
EMAIL_USER=votre.email@gmail.com

# Mot de passe d'application (Gmail) ou mot de passe SMTP
# 🔒 Pour Gmail : activez la double authentification, puis créez un "Mot de passe d'application"
EMAIL_PASSWORD=votre_mot_de_passe_application

# Nom et email de l'expéditeur affiché dans les emails
EMAIL_FROM="StageTrack" <no-reply@stagetrack.com>

# ================================================================
# 6. OPTIONNEL - Configuration SMTP avancée
# ================================================================
 EMAIL_HOST=smtp.gmail.com
 EMAIL_PORT=587
 EMAIL_SECURE=false  # false pour port 587, true pour port 465

# ================================================================
# 7. OPTIONNEL - UPLOAD DE FICHIERS
# ================================================================
 MAX_FILE_SIZE=5242880  # 5 Mo en octets
 UPLOAD_DIR=uploads/applications

# ================================================================
# 8. OPTIONNEL - SÉCURITÉ ET PERFORMANCE
# ================================================================
 RATE_LIMIT_WINDOW=15  # minutes
 RATE_LIMIT_MAX=100    # requêtes par fenêtre